{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mindmap",
  "version": "0.1.2",
  "identifier": "com.lizanzz.mindmap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mindmap",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQUJBMUI0MTlCREMzQTcKUldTbnc3MFp0S0dyZWhzZUZKajUvUHI2ZmxudllGRGpkVkZJRzZvc29hL1c2MVFKUlJRVHk5RTkK",
      "endpoints": [
        "https://github.com/islizanzz/mindmap/releases/latest/download/latest.json"
      ]
    }
  }
}
